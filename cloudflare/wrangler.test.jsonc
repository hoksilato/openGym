{
  "name": "opengym-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "opengym-test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "OpenGym" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OpenGym"] }]
}
